{
  // App estática (carpeta dist) + servidor pequeño (worker/index.js) para cuentas y diseños guardados.
  // El nombre debe coincidir con el del proyecto en Cloudflare ("mobilabs").
  "name": "mobilabs",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Base de datos D1 con usuarios, sesiones y diseños guardados (las tablas se crean solas).
  "d1_databases": [
    { "binding": "DB", "database_name": "mobilabs-db", "database_id": "bb923e32-87e8-4ea1-beed-4780baf82a13" }
  ],
  // Las variables del panel de Cloudflare (ADMIN_EMAILS, MAIL_USER, MAIL_APP_PASSWORD) no se borran al publicar.
  "keep_vars": true
}
